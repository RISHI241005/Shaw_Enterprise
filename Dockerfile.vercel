FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml .
RUN mvn -q -DskipTests dependency:go-offline
COPY src src
COPY public public
RUN mvn -q -DskipTests package
RUN java -Djarmode=tools -jar target/shaw-enterprise-*.jar extract --destination /workspace/application

FROM eclipse-temurin:21-jre
WORKDIR /app
RUN useradd --system --uid 10001 shaw
COPY --from=build /workspace/application/ /app/
COPY --from=build /workspace/public /app/public
ENV JAVA_TOOL_OPTIONS="-Xms64m -Xmx512m -Xss512k -XX:ActiveProcessorCount=2 -XX:TieredStopAtLevel=1 -XX:+UseSerialGC -Djava.security.egd=file:/dev/urandom"
USER shaw
EXPOSE 3000
ENTRYPOINT ["java", "-jar", "/app/shaw-enterprise-2.0.0.jar"]
