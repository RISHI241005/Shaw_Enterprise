{
  "name": "shaw-enterprise",
  "version": "3.0.0",
  "description": "Single-project Vercel storefront and API for Shaw Enterprise, backed by MySQL/TiDB.",
  "main": "api/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env api/index.js",
    "dev": "node --watch --env-file-if-exists=.env api/index.js",
    "build": "node --check api/index.js",
    "vercel-build": "node --check api/index.js",
    "test": "node --test tests/vercel-app.test.js",
    "java:test": "mvn test",
    "java:package": "mvn clean package"
  },
  "keywords": [
    "shaw-enterprise",
    "wholesale",
    "retail",
    "disposable-products",
    "vercel",
    "mysql",
    "tidb",
    "spring-boot"
  ],
  "author": "Shaw Enterprise",
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^5.1.0",
    "mysql2": "^3.14.5"
  }
}
